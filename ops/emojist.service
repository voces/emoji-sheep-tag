[Unit]
Description=emojist
Documentation=https://github.com/voces/emoji-sheep-tag
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/emoji-sheep-tag
ExecStart=/home/ubuntu/.bun/bin/bun server/index.ts
Environment=PORT=3030
StateDirectory=emojist
Environment=STATUS_DB_PATH=/var/lib/emojist/status.db
EnvironmentFile=/etc/emojist/env
CPUQuota=50%
CPUQuotaPeriodSec=1s
CPUWeight=900
IOWeight=900
KillMode=mixed
WatchdogSec=10
TimeoutStopSec=2s
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
